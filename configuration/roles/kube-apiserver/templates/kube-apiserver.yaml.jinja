---
apiVersion: v1
kind: Pod
metadata:
  name: kube-apiserver
  namespace: kube-system
  labels:
    node-role.kubernetes.io/control-plane: "true"
    component: kube-apiserver
spec:
  hostNetwork: true
  priorityClassName: system-cluster-critical
  containers:
    - name: kube-apiserver
      image: registry.k8s.io/kube-apiserver:v{{ kube_apiserver_version }}
      command:
        - kube-apiserver
        {{ _kube_apiserver_static_pod_flags | indent(8) }}
      volumeMounts:
        - name: kubernetes-encryption-config
          mountPath: /etc/kubernetes/encryption-config.yaml
          readOnly: true
        - name: kubernetes-pki
          mountPath: /etc/kubernetes/pki
          readOnly: true
        - name: etcd-pki
          mountPath: /etc/etcd/pki
          readOnly: true
      ports:
        - containerPort: 6443
          hostPort: 6443
  volumes:
    - name: kubernetes-pki
      hostPath:
        path: {{ kube_apiserver_pki_dir }}
        type: Directory
    - name: etcd-pki
      hostPath:
        path: {{ kube_apiserver_etcd_pki_dir }}
        type: Directory
    - name: kubernetes-encryption-config
      hostPath:
        path: /etc/kubernetes/encryption-config.yaml
        type: File
